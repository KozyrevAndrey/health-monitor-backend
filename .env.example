# Domain for Traefik routing
DOMAIN=monitor.yourdomain.ru

# Login credentials for the web dashboard
AUTH_USER=admin
AUTH_PASS=your-strong-password

# SMSPILOT API key for voice-call alerts (optional).
# Kept out of the database on purpose: the app reads it from the environment.
SMSPILOT_API_KEY=

# App version tag (used during docker build)
VERSION=latest
